# Database connection (cPanel PostgreSQL)
# Format: postgresql://<user>:<password>@127.0.0.1:5432/<dbname>?schema=public
DATABASE_URL="postgresql://username_dbuser:your_password@127.0.0.1:5432/username_dbname?schema=public"

# JWT and Session secret keys
JWT_SECRET="gt-international-academy-jwt-secret-key-2026"
AUTH_SECRET="gt-international-academy-auth-secret-key-2026"
SESSION_SECRET="gt-international-academy-session-secret-key-2026"

# App Branding
NEXT_PUBLIC_APP_NAME="Global Tech International Academy"
NEXT_PUBLIC_APP_TAGLINE="Student, Course & Fee Billing Management"

# Environment
NODE_ENV="production"
PORT=3000
