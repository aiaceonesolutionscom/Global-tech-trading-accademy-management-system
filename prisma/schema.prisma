generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  FINANCE
  STAFF
}

enum Status {
  ACTIVE
  INACTIVE
  ARCHIVED
}

enum BillingMode {
  ONE_TIME
  MONTHLY
}

enum DurationUnit {
  MONTHS
  WEEKS
  DAYS
}

enum DiscountType {
  NONE
  FIXED
  PERCENTAGE
}

enum TaxType {
  NONE
  FIXED
  PERCENTAGE
}

enum BillStatus {
  DRAFT
  UNPAID
  PARTIALLY_PAID
  PAID
  OVERDUE
  CANCELLED
}

enum EnrollmentStatus {
  PENDING
  ACTIVE
  COMPLETED
  CANCELLED
}

enum PaymentMethod {
  CASH
  BANK_TRANSFER
  ONLINE
  CHEQUE
  OTHER
}

enum NotificationType {
  UPCOMING_DUE
  OVERDUE
  PARTIAL_REMAINING
  MONTHLY_DUE
  GENERAL
}

model User {
  id           String     @id @default(uuid())
  name         String
  email        String     @unique
  passwordHash String
  role         Role       @default(ADMIN)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  feeBills     FeeBill[]  @relation("CreatedFeeBills")
  payments     Payment[]  @relation("CreatedPayments")
  auditLogs    AuditLog[]
}

model Student {
  id               String         @id @default(uuid())
  studentCode      String         @unique
  fullName         String
  guardianName     String?
  phone            String
  email            String?
  cnic             String?
  address          String?
  dob              DateTime?
  registrationDate DateTime       @default(now())
  status           Status         @default(ACTIVE)
  notes            String?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  enrollments      Enrollment[]
  feeBills         FeeBill[]
  payments         Payment[]
  notifications    Notification[]
}

model Trainer {
  id             String       @id @default(uuid())
  trainerCode    String       @unique
  name           String
  phone          String?
  email          String?
  specialization String?
  status         Status       @default(ACTIVE)
  notes          String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  courses        Course[]
  courseTrainers CourseTrainer[]
  enrollments    Enrollment[]
}

model Course {
  id            String          @id @default(uuid())
  courseCode    String          @unique
  name          String
  description   String?
  trainerId     String?
  trainer       Trainer?        @relation(fields: [trainerId], references: [id], onDelete: SetNull)
  trainers      CourseTrainer[]
  defaultPrice  Decimal         @db.Decimal(12, 2)
  durationValue Int             @default(1)
  durationUnit  DurationUnit    @default(MONTHS)
  billingMode   BillingMode     @default(ONE_TIME)
  status        Status          @default(ACTIVE)
  notes         String?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  enrollments   Enrollment[]
  feeBillItems  FeeBillItem[]
}

model CourseTrainer {
  id         String   @id @default(uuid())
  courseId   String
  course     Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  trainerId  String
  trainer    Trainer  @relation(fields: [trainerId], references: [id], onDelete: Cascade)
  assignedAt DateTime @default(now())

  @@unique([courseId, trainerId])
  @@index([courseId])
  @@index([trainerId])
}

model Enrollment {
  id             String           @id @default(uuid())
  enrollmentCode String           @unique
  studentId      String
  student        Student          @relation(fields: [studentId], references: [id], onDelete: Cascade)
  courseId       String
  course         Course           @relation(fields: [courseId], references: [id], onDelete: Cascade)
  trainerId      String?
  trainer        Trainer?         @relation(fields: [trainerId], references: [id], onDelete: SetNull)
  enrollmentDate DateTime         @default(now())
  billingMode    BillingMode      @default(ONE_TIME)
  durationValue  Int              @default(1)
  durationUnit   DurationUnit     @default(MONTHS)
  status         EnrollmentStatus @default(ACTIVE)
  completionDate DateTime?
  notes          String?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  @@index([studentId, courseId])
  @@index([status])
  @@index([enrollmentDate])
}

model FeeBill {
  id                  String              @id @default(uuid())
  billNumber          String              @unique
  studentId           String
  student             Student             @relation(fields: [studentId], references: [id], onDelete: Cascade)
  billDate            DateTime            @default(now())
  startDate           DateTime?
  endDate             DateTime?
  dueDate             DateTime?
  billingMode         BillingMode         @default(ONE_TIME)
  subtotal            Decimal             @default(0.00) @db.Decimal(12, 2)
  discountType        DiscountType        @default(NONE)
  discountValue       Decimal             @default(0.00) @db.Decimal(12, 2)
  discountAmount      Decimal             @default(0.00) @db.Decimal(12, 2)
  taxName             String?             @default("GST")
  taxType             TaxType             @default(NONE)
  taxValue            Decimal             @default(0.00) @db.Decimal(12, 2)
  taxAmount           Decimal             @default(0.00) @db.Decimal(12, 2)
  grandTotal          Decimal             @default(0.00) @db.Decimal(12, 2)
  paidAmount          Decimal             @default(0.00) @db.Decimal(12, 2)
  remainingAmount     Decimal             @default(0.00) @db.Decimal(12, 2)
  previousOutstanding Decimal             @default(0.00) @db.Decimal(12, 2)
  status              BillStatus          @default(UNPAID)
  notes               String?
  createdById         String?
  createdBy           User?               @relation("CreatedFeeBills", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt
  items               FeeBillItem[]
  allocations         PaymentAllocation[]
  notifications       Notification[]

  @@index([studentId, status])
  @@index([billDate])
  @@index([dueDate, remainingAmount])
  @@index([status, remainingAmount])
}

model FeeBillItem {
  id            String       @id @default(uuid())
  feeBillId     String
  feeBill       FeeBill      @relation(fields: [feeBillId], references: [id], onDelete: Cascade)
  courseId      String
  course        Course       @relation(fields: [courseId], references: [id], onDelete: Cascade)
  defaultPrice  Decimal      @db.Decimal(12, 2)
  overridePrice Decimal?     @db.Decimal(12, 2)
  billingMode   BillingMode  @default(ONE_TIME)
  durationValue Int          @default(1)
  durationUnit  DurationUnit @default(MONTHS)
  lineTotal     Decimal      @db.Decimal(12, 2)
  notes         String?
}

model Payment {
  id              String              @id @default(uuid())
  receiptNumber   String              @unique
  studentId       String
  student         Student             @relation(fields: [studentId], references: [id], onDelete: Cascade)
  paymentDate     DateTime            @default(now())
  amount          Decimal             @db.Decimal(12, 2)
  paymentMethod   PaymentMethod       @default(CASH)
  referenceNumber String?
  notes           String?
  createdById     String?
  createdBy       User?               @relation("CreatedPayments", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  allocations     PaymentAllocation[]

  @@index([studentId, paymentDate])
}

model PaymentAllocation {
  id              String   @id @default(uuid())
  paymentId       String
  payment         Payment  @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  feeBillId       String
  feeBill         FeeBill  @relation(fields: [feeBillId], references: [id], onDelete: Cascade)
  amountAllocated Decimal  @db.Decimal(12, 2)
  notes           String?
  createdAt       DateTime @default(now())

  @@index([paymentId])
  @@index([feeBillId])
}

model Notification {
  id        String           @id @default(uuid())
  title     String
  message   String
  type      NotificationType @default(GENERAL)
  studentId String?
  student   Student?         @relation(fields: [studentId], references: [id], onDelete: SetNull)
  feeBillId String?
  feeBill   FeeBill?         @relation(fields: [feeBillId], references: [id], onDelete: SetNull)
  isRead    Boolean          @default(false)
  createdAt DateTime         @default(now())

  @@index([isRead, createdAt])
}

model Setting {
  id        String   @id @default(uuid())
  key       String   @unique
  value     String
  group     String   @default("GENERAL")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model AuditLog {
  id        String   @id @default(uuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action    String
  entity    String
  entityId  String?
  details   String?
  createdAt DateTime @default(now())

  @@index([entity, entityId])
}
