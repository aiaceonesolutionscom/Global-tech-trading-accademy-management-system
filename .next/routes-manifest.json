{
  "version": 3,
  "pages404": true,
  "caseSensitive": false,
  "basePath": "",
  "redirects": [
    {
      "source": "/:path+/",
      "destination": "/:path+",
      "internal": true,
      "statusCode": 308,
      "regex": "^(?:/((?:[^/]+?)(?:/(?:[^/]+?))*))/$"
    }
  ],
  "headers": [
    {
      "source": "/((?!_next/static|_next/image|favicon.png).*)",
      "headers": [
        {
          "key": "X-DNS-Prefetch-Control",
          "value": "on"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains; preload"
        },
        {
          "key": "X-XSS-Protection",
          "value": "1; mode=block"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), browsing-topics=()"
        },
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate, max-age=0"
        },
        {
          "key": "Pragma",
          "value": "no-cache"
        }
      ],
      "regex": "^(?:/((?!_next/static|_next/image|favicon.png).*))(?:/)?$"
    },
    {
      "source": "/_next/static/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ],
      "regex": "^/_next/static(?:/(.*))(?:/)?$"
    }
  ],
  "rewrites": {
    "beforeFiles": [],
    "afterFiles": [],
    "fallback": []
  },
  "dynamicRoutes": [
    {
      "page": "/api/courses/[id]",
      "regex": "^/api/courses/([^/]+?)(?:/)?$",
      "routeKeys": {
        "nxtPid": "nxtPid"
      },
      "namedRegex": "^/api/courses/(?<nxtPid>[^/]+?)(?:/)?$"
    },
    {
      "page": "/api/enrollments/[id]",
      "regex": "^/api/enrollments/([^/]+?)(?:/)?$",
      "routeKeys": {
        "nxtPid": "nxtPid"
      },
      "namedRegex": "^/api/enrollments/(?<nxtPid>[^/]+?)(?:/)?$"
    },
    {
      "page": "/api/enrollments/[id]/fee-bill",
      "regex": "^/api/enrollments/([^/]+?)/fee\\-bill(?:/)?$",
      "routeKeys": {
        "nxtPid": "nxtPid"
      },
      "namedRegex": "^/api/enrollments/(?<nxtPid>[^/]+?)/fee\\-bill(?:/)?$"
    },
    {
      "page": "/api/fee-bills/student/[studentId]/outstanding",
      "regex": "^/api/fee\\-bills/student/([^/]+?)/outstanding(?:/)?$",
      "routeKeys": {
        "nxtPstudentId": "nxtPstudentId"
      },
      "namedRegex": "^/api/fee\\-bills/student/(?<nxtPstudentId>[^/]+?)/outstanding(?:/)?$"
    },
    {
      "page": "/api/fee-bills/[id]",
      "regex": "^/api/fee\\-bills/([^/]+?)(?:/)?$",
      "routeKeys": {
        "nxtPid": "nxtPid"
      },
      "namedRegex": "^/api/fee\\-bills/(?<nxtPid>[^/]+?)(?:/)?$"
    },
    {
      "page": "/api/students/[id]",
      "regex": "^/api/students/([^/]+?)(?:/)?$",
      "routeKeys": {
        "nxtPid": "nxtPid"
      },
      "namedRegex": "^/api/students/(?<nxtPid>[^/]+?)(?:/)?$"
    },
    {
      "page": "/api/trainers/[id]",
      "regex": "^/api/trainers/([^/]+?)(?:/)?$",
      "routeKeys": {
        "nxtPid": "nxtPid"
      },
      "namedRegex": "^/api/trainers/(?<nxtPid>[^/]+?)(?:/)?$"
    },
    {
      "page": "/fee-bills/[id]",
      "regex": "^/fee\\-bills/([^/]+?)(?:/)?$",
      "routeKeys": {
        "nxtPid": "nxtPid"
      },
      "namedRegex": "^/fee\\-bills/(?<nxtPid>[^/]+?)(?:/)?$"
    },
    {
      "page": "/fee-bills/[id]/edit",
      "regex": "^/fee\\-bills/([^/]+?)/edit(?:/)?$",
      "routeKeys": {
        "nxtPid": "nxtPid"
      },
      "namedRegex": "^/fee\\-bills/(?<nxtPid>[^/]+?)/edit(?:/)?$"
    },
    {
      "page": "/students/[id]",
      "regex": "^/students/([^/]+?)(?:/)?$",
      "routeKeys": {
        "nxtPid": "nxtPid"
      },
      "namedRegex": "^/students/(?<nxtPid>[^/]+?)(?:/)?$"
    }
  ],
  "staticRoutes": [
    {
      "page": "/",
      "regex": "^/(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/(?:/)?$"
    },
    {
      "page": "/_not-found",
      "regex": "^/_not\\-found(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/_not\\-found(?:/)?$"
    },
    {
      "page": "/courses",
      "regex": "^/courses(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/courses(?:/)?$"
    },
    {
      "page": "/dashboard",
      "regex": "^/dashboard(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/dashboard(?:/)?$"
    },
    {
      "page": "/enrollments",
      "regex": "^/enrollments(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/enrollments(?:/)?$"
    },
    {
      "page": "/fee-bills",
      "regex": "^/fee\\-bills(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/fee\\-bills(?:/)?$"
    },
    {
      "page": "/fee-bills/new",
      "regex": "^/fee\\-bills/new(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/fee\\-bills/new(?:/)?$"
    },
    {
      "page": "/login",
      "regex": "^/login(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/login(?:/)?$"
    },
    {
      "page": "/payments",
      "regex": "^/payments(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/payments(?:/)?$"
    },
    {
      "page": "/reminders",
      "regex": "^/reminders(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/reminders(?:/)?$"
    },
    {
      "page": "/reports",
      "regex": "^/reports(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/reports(?:/)?$"
    },
    {
      "page": "/settings",
      "regex": "^/settings(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/settings(?:/)?$"
    },
    {
      "page": "/students",
      "regex": "^/students(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/students(?:/)?$"
    },
    {
      "page": "/trainers",
      "regex": "^/trainers(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/trainers(?:/)?$"
    }
  ],
  "dataRoutes": [],
  "rsc": {
    "header": "rsc",
    "varyHeader": "rsc, next-router-state-tree, next-router-prefetch, next-router-segment-prefetch",
    "prefetchHeader": "next-router-prefetch",
    "didPostponeHeader": "x-nextjs-postponed",
    "contentTypeHeader": "text/x-component",
    "suffix": ".rsc",
    "prefetchSuffix": ".prefetch.rsc",
    "prefetchSegmentHeader": "next-router-segment-prefetch",
    "prefetchSegmentSuffix": ".segment.rsc",
    "prefetchSegmentDirSuffix": ".segments"
  },
  "rewriteHeaders": {
    "pathHeader": "x-nextjs-rewritten-path",
    "queryHeader": "x-nextjs-rewritten-query"
  }
}